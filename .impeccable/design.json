      "css": ".ds-access-nav{display:grid;grid-template-columns:1fr 1fr;gap:4px;padding:4px;border-radius:var(--cia-radius,12px);background:#eaf2f5}.ds-access-link{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;display:grid;place-items:center;min-height:44px;border-radius:9px;color:var(--cia-muted,#446477);font-size:14px;font-weight:700;text-decoration:none;transition:background var(--cia-duration,180ms),color var(--cia-duration,180ms)}.ds-access-link:hover{color:var(--cia-deep,#173c50)}.ds-access-link.ds-active{background:var(--cia-paper,#fffdfa);color:var(--cia-deep,#173c50);box-shadow:0 3px 10px rgba(23,60,80,.08)}.ds-control:focus-visible{outline:3px solid var(--cia-focus,#347da0);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-access-link{transition:none}}"
