      "html": "<button class=\"ds-control ds-primary\" type=\"button\">Crear cuenta</button>",
      "css": ".ds-primary{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:14px 24px;border:1px solid transparent;border-radius:13px;background:var(--cia-deep,#173c50);color:#fff;font-size:16px;font-weight:710;letter-spacing:-.01em;cursor:pointer;box-shadow:0 11px 26px rgba(23,60,80,.17);transition:background .2s,color .2s,transform .22s cubic-bezier(.16,1,.3,1),box-shadow .22s cubic-bezier(.16,1,.3,1)}.ds-primary:hover:not(:disabled){background:#275972;transform:translateY(-2px);box-shadow:0 14px 30px rgba(23,60,80,.23)}.ds-primary:disabled{opacity:.56;cursor:not-allowed;box-shadow:none}.ds-control:focus-visible{outline:3px solid var(--cia-focus,#347da0);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
