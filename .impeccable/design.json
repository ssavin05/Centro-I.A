      "css": ".ds-field-label{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;display:block;margin-bottom:6px;font-size:14px;font-weight:650;color:var(--cia-deep,#173c50)}.ds-field{font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;display:block;width:100%;min-width:0;height:46px;padding:10px 12px;border:1px solid #b7ccd6;border-radius:9px;background:var(--cia-paper,#fffdfa);color:var(--cia-deep,#173c50);font-size:16px;transition:border-color var(--cia-duration,180ms)}.ds-field::placeholder{color:#5d7583;font-size:14px}.ds-field:focus{border-color:var(--cia-focus,#347da0)}.ds-field[aria-invalid=\"true\"]{border-color:var(--cia-error,#a02e38)}.ds-field[readonly]{background:#eef3f5}.ds-control:focus-visible{outline:3px solid var(--cia-focus,#347da0);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-field{transition:none}}"
