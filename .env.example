# Uso local: npm start (Node.js >=22.13)
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/centro-ia.sqlite
NODE_ENV=development

# Producción: alojar app y API bajo el MISMO dominio HTTPS.
# En Render se detecta RENDER_EXTERNAL_URL automáticamente.
# Configura PUBLIC_ORIGIN si usas un dominio propio.
PUBLIC_ORIGIN=

# Opcional para análisis de IA; mantener solo del lado servidor.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
