# Valores opcionales. Para iniciar normalmente basta con: npm start
# Si creas un archivo .env, inicia con: node --env-file=.env server/index.mjs
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/centro-ia.sqlite
NODE_ENV=development

# Para producción: configura una dirección HTTPS real (p. ej. https://app.tudominio.com)
# y NODE_ENV=production, HOST=0.0.0.0. No uses localhost como origen público.
PUBLIC_ORIGIN=

# Opcional. El asistente generativo necesita una clave obtenida por el propietario.
# Nunca compartas esta clave ni la pongas en app/app.js
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini